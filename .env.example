# ─────────────────────────────────────────────────────────────
# On-Track — environment template
# Copy to `.env` and fill in real values:   cp .env.example .env
# Never commit the real `.env` / `.env.local` files.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (used by Prisma)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/ontrack"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-random-secret-here"

# Public base URL of the app
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave empty to disable "Continue with Google")
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
